[{"k":"sc","n":"광한루원","la":35.40392,"ln":127.37976,"c":"kr","t":"playground","a":"전라북도 남원시 요천로 1447","h":"매일 08시 - 19시 (무료개장 19시 - 21시) 하절기, 매일 08시 - 18시 (무료개장 18시 - 20시) 동절기","w":[{"ti":"간 떨어지는 동거","m":"drama","d":"1화에서 학교 프로젝트로 이담( 혜리)과 최수경(박경혜)이 이곳을 찾는다. 그들은 한복을 입고 광한루 바로 앞에 있는 다리에 앉아 사극의 한 장면을 연기하는 시늉을 한다."},{"ti":"간택 - 여인들의 전쟁","m":"drama","d":"1화에서 여왕 자리를 노리는 자들이 오작교를 건너고, 왕 이경(김민구 분)이 지망생 중 한 명인 강은기(진세윤 분)와 데이트를 하는 곳이다. 11화에서는 왕과 강은보(진세연)가 이 정원의 봉래섬에서 키스를 나눈다."},{"ti":"광해","m":"movie","d":"이병헌이 한효주에게 시 읽어주는 장소"},{"ti":"구르미 그린 달빛","m":"drama","d":"1화에서 효명세자(박보검)는 아버지 왕이 지나갈 때 이 정원의 봉래섬에 있는 영주각에서 공부하는 척한다. 5화에서 명은공주(정혜성 분)는 홍라온(김유정 분)에게 정원의 호수 위에서 배를 타자고 부탁한다. 세자 효명은 옆을 지나 그…"},{"ti":"달의 연인 - 보보경심 려","m":"drama","d":"4회에서 해수(이지은)를 구한 뒤 이 정원의 다리 위에서 그녀를 잃을까봐 얼마나 무서웠는지 말해주고, 키스를 위해 몸을 기울였을 때 그들은 방해를 받는다."},{"ti":"백일의 낭군님","m":"drama","d":"드라마에서 주인공들이 궁궐 정원에서 만나 대화를 하는 장소 (특히 광한루, 오작교, 완월정) 로 나온다"}],"nw":17},{"k":"sc","n":"구서도역 영상촬영장","la":35.49074,"ln":127.32931,"c":"kr","t":"playground","a":"전라북도 남원시 사매면 서도길 32","h":"매일 00시 - 24시","w":[{"ti":"미스터 션샤인","m":"drama","d":"총 분실로 고애신이 미군에게 모욕을 당한 곳"}],"nw":1},{"k":"sc","n":"경방루","la":35.40554,"ln":127.37963,"c":"kr","t":"restaurant","a":"전라북도 남원시 광한북로 29","h":"매일 11시 - 21시","w":[{"ti":"백종원의3대천왕","m":"show","d":"백종원의 3대 천왕 25회 100년 탕수육 맛집"}],"nw":1},{"k":"sc","n":"명문제과","la":35.40901,"ln":127.38249,"c":"kr","t":"cafe","a":"전라북도 남원시 용성로 56","h":"화-일 10시 - 20시","w":[{"ti":"백종원의3대천왕","m":"show","d":"백종원의 3대 천왕 32회 생크림소보로/슈보르 맛집"}],"nw":1},{"k":"sc","n":"진고개식당","la":35.40682,"ln":127.38167,"c":"kr","t":"restaurant","a":"전라북도 남원시 하정2길 6","h":"매일 12시 - 22시","w":[{"ti":"백종원의3대천왕","m":"show","d":"백종원의 3대 천왕 27회 삼겹살 맛집"}],"nw":1},{"k":"sc","n":"춘향테마파크","la":35.40165,"ln":127.38672,"c":"kr","t":"playground","a":"전라북도 남원시 양림길 43","h":"하절기 매일 09시 - 22시, 동절기 매일 09시 - 21시","w":[{"ti":"빅톤","m":"artist","d":"투어 아바타 11화 전북 편에 나온 테마파크"}],"nw":1},{"k":"sc","n":"남원랜드","la":35.40303,"ln":127.3924,"c":"kr","t":"playground","a":"전라북도 남원시 양림길