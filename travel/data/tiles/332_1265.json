[{"k":"sc","n":"외돌개","la":33.23998,"ln":126.54545,"c":"kr","t":"playground","a":"제주특별자치도 서귀포시 서홍동 791","h":"매일 00시 - 24시","w":[{"ti":"대장금","m":"drama","d":"27회에서 최상궁은 궁궐의 모든 부엌을 총괄하는 감독이 되기 위해 음모를 꾸미고, 먹고 병에 걸린 중종을 위해 한상궁(양미경)과 장금(이영애)이 준비한 오리밥을 독살한다. 반역죄로 기소된 두 여인은 구타를 당하고 제주도로 유배되지만…"},{"ti":"방탄소년단","m":"artist","d":"방탄소년단 화양연화 자켓 사진 촬영지"},{"ti":"어느 날 우리 집 현관으로 멸망이 들어왔다","m":"drama","d":"11회에서 그녀가 제주도로 가출한 지 며칠 후, 동경(박보영)의 가족과 친구는 멸망(서인국)의 연락을 받아 도착한다. 동경은 절친 지나(신도현)와 함께 오솔길을 걸으며 이 랜드마크 전망대에 들러 셀카를 찍는다. 그녀는 자신의 도피…"}],"nw":3},{"k":"sc","n":"대도식당","la":33.24398,"ln":126.56252,"c":"kr","t":"restaurant","a":"제주특별자치도 서귀포시 솔동산로22번길 18","h":"월-토 08시 - 15시","w":[{"ti":"백종원의3대천왕","m":"show","d":"백종원의 3대 천왕 78회 김치복국  맛집"},{"ti":"식신로드","m":"show","d":"식신로드1 230회 김치복국 맛집"}],"nw":2},{"k":"sc","n":"제스토리","la":33.23612,"ln":126.515,"c":"kr","t":"restaurant","a":"제주특별자치도 서귀포시 막숙포로 60","h":"매일 09시 - 21시","w":[{"ti":"기분좋은 날","m":"show","d":"기분좋은날 2270회 제주소품샵 맛집"}],"nw":1},{"k":"sc","n":"풍차맛집 (레인보우)","la":33.24693,"ln":126.57424,"c":"kr","t":"restaurant","a":"제주특별자치도 서귀포시 칠십리로 203","h":"매일 10시 - 22시","w":[{"ti":"레인보우","m":"artist","d":"데뷔 5주년을 맞이해 제주도 여행가서 먹은 곳"}],"nw":1},{"k":"sc","n":"제주올레여행자센터","la":33.24745,"ln":126.5587,"c":"kr","t":"playground","a":"제주특별자치도 서귀포시 서귀동 중정로 22","h":"매일 08시 - 22시","w":[{"ti":"맛남의광장","m":"show","d":"맛남의 광장에서 방문한 제주올레 여행자 센터"}],"nw":1},{"k":"sc","n":"친봉산장","la":33.29119,"ln":126.59637,"c":"kr","t":"cafe","a":"제주특별자치도 서귀포시 하신상로 417","h":"매일 11시 - 21시","w":[{"ti":"배틀트립","m":"show","d":"배틀트립 109회 아이리시커피 맛집"}],"nw":1},{"k":"sc","n":"치유의 숲","la":33.29203,"ln":126.52941,"c":"kr","t":"playground","a":"제주특별자치도 서귀포시 산록남로 2271","h":"하절기 매일 08시 - 17시, 동절기 매일 09시 - 16시","w":[{"ti":"사랑의 불시착","m":"drama","d":"세리가 하늘에서 불시착해 리정혁을 만난 숲"}],"nw":1},{"k":"sc","n":"마농오메기통닭마농문어통닭","la":33.24964,"ln":126.56309,"c":"kr","t":"restaurant","a":"제주특별자치도 서귀포시 중정로61번길 20 1층","h":"매일 12시 - 22시","w":[{"ti":"생방송오늘저녁","m":"show","d":"생방송오늘저녁 1848회 마농오메기통닭 맛집"}],"nw":1},{"k":"sc","n"