[{"k":"sc","n":"인천국제공항","la":37.44919,"ln":126.4514,"c":"kr","t":"playground","a":"인천광역시 중구 공항로 272","h":"매일 00시 - 24시","w":[{"ti":"20세기 소년소녀","m":"drama","d":"1화에서 사진진(한예슬)이 이곳을 떠나 상하이로 떠난다."},{"ti":"9회말 2아웃","m":"drama","d":"1회에서 홍난희(수애)가 변형태(이정진)를 이곳으로 보내는 장면이 나왔다."},{"ti":"간 떨어지는 동거","m":"drama","d":"6화에서 이담의 어머니(오현경)가 미국에서 입국한 뒤 공항에서 이담(걸스데이 혜리)에게 연락한다."},{"ti":"검색어를 입력하세요 WWW","m":"drama","d":"13화에서 송가경(전혜진)은 유니콘 본사 직원과의 만남을 마치고 상하이에서 돌아온다. 입국장에 들어서자 자신을 기다리고 있는 오진우(지승현)를 보고 놀란다."},{"ti":"경우의 수","m":"drama","d":"1화에서 이수(워너원 출신 옹성우)가 미국행 비행기에 오르기 직전 경우연(신예은)이 이수 공항에서 마중을 나온다."},{"ti":"공항 가는 길","m":"drama","d":"이곳은 최수아(김하늘)와 박진숙(신성록)의 작업실이다."}],"nw":86},{"k":"sc","n":"파라다이스시티","la":37.43762,"ln":126.45597,"c":"kr","t":"stay","a":"인천광역시 중구 영종해안남로321번길 186","h":"매일 입실 15시, 퇴실 11시","w":[{"ti":"군검사 도베르만","m":"drama","d":"1회에서 본 클럽 '카르텔'의 외관입니다."},{"ti":"굿잡","m":"drama","d":"1화에서 은선우(정일우)가 제보자를 쫓고 돈세라(권유리/소녀시대 유리)가 아르바이트를 하는 '로열호텔'이다."},{"ti":"그녀의 사생활","m":"drama","d":"1화에서 성덕미(박민영)와 라이언 골드(김재욱)가 참석한 상하이 미술품 경매가 열리는 곳이다."},{"ti":"그래서 나는 안티팬과 결혼했다","m":"drama","d":"1화에서 이곳의 외관은 JJ(황찬성/2PM 찬성)가 연 클럽으로 등장한다."},{"ti":"김비서가 왜 그럴까","m":"drama","d":"11회에서 김미소(박민영)는 동료 김지아(표예진), 봉세라(황보라)와 함께 스파 서비스에 대한 피드백을 구한다는 전제로 휴식을 취하기 위해 유명 일루전 호텔 스파를 찾았다."},{"ti":"나의 해방일지","m":"drama","d":"손석구가 2022 새해를 맞이하며 나오는 클럽"}],"nw":24},{"k":"sc","n":"그랜드 하얏트 인천","la":37.44045,"ln":126.45747,"c":"kr","t":"stay","a":"인천광역시 중구 영종해안남로321번길 208","h":"매일 입실 15시, 퇴실 11시","w":[{"ti":"(아는 건 별로 없지만) 가족입니다","m":"drama","d":"1회에서 김은희(한예리)사 P&F 북의 신임 부사장 임건주(신동욱)를 위한 환영 만찬은 펼쳐진다. 안으로 들어서자 결혼 1주년을 맞아 아내가 도착하기를 기다리는 전 남자친구 이종민(최웅 분)과 마주친다."},{"ti":"굿캐스팅","m":"drama","d":"팰리스 호텔'로 나오는 이 호텔은, 7회에서 국정원 3팀이 옥철(김용희)이 '마이클'(생각대로)을 만나기로 했다는 사실을 알게 된다. 백찬미(최강희 분)가 우연히 이 호텔에서 동시에 소개팅을 하는 사이, 동관수(이종혁 분)가 호텔…"},{"ti":"너는 나의 봄","m":"drama","d":"드라마 주인공인 강다정(서현진)은 이 호텔의 컨시어지 매니저로 일하고 있다."},{"ti":"달리와 감자탕","m":"drama","d":"4화에서 진무학(김민재)이 김달리(박규영)를 이 호텔에 내려준다. 그녀는 그럴 여유가 없어 무학이 헤어지자마자 떠난다. 5화에서, 그는 그녀를 다시 여기로 데려오고, 이번에는 그녀를 위해 돈을 지불한다. 그리고 다시, 그녀는 머물지…"},{"ti":"두번은 없다","m":"drama","d":"드라마에서 이 호텔의 외관은 '구성 호텔'로 등장한다."},{"ti":"마인","m":"drama","d":"극 중 등장인물이 운영하고있는 효원그룹중 하나인 '효원호텔' 로 등장인물들이 자주 등장하는 장소이다"}],"nw":17},{"k":"sc","n":"강남역","la":37.49317,"ln":126.43448,"c":"kr","t":"station","a":"서울특별시 강남구 강남대로 396","h":"매일 05시 - (익일) 01시","w":[{"ti":"눈의 여왕","m":"drama","d":"13회에서 김보라(성유리)와 한득구(현빈)가 이 역의 11번 출구로 걸어갈 때 그는 그녀의 집에 걸어갑니다."},{"ti":"별에서 온 그대","m":"drama","d":"5회에서 도민준(김수현)은 자전거를 타고 이 역 출구를 지날 때 천송이(전지현)의 광고판이 철거되는 것을 본다."},{"ti":"철인왕후","m":"drama","d":"20화에서 식물인간 상태에서 깨어난 장봉환(최진혁)은 병원을 탈출하고 결국 이 역 1번 출구를 나서게 된다."},{"ti":"VIP","m":"drama","d":"3화(전체 2화)에서 이 역 6번 출구는 온유리(표예진)가 상점들을 지나는 모습이 보인다."}],"nw":4},{"k":"sc","n":"삼목선착장","la":37.49872,"ln":126.45387,"c":"kr","t":"playground","a":"인천광역시 중구 영종해안북로 847번길 55","h":"산목에서는 매시 10분마다, 신도에서는 매시 30분마다 출발","w":[{"ti":"런닝맨","m":"show","d":"런닝맨 399회 신시모도 가는 배를 탄 곳"}],"nw":1},{"k":"sc","n":"서해안조개광장","la":37.42802,"ln":126.41873,"c":"kr","t":"restaurant","a":"인천광역시 중구 마시란로 65","h":"일-목 11시 - 22시, 금 11시 - 23시, 토 11시 - 23시 30분","w":[{"ti":"맛있는 녀석들","m":"show","d":"맛있는녀석들 363회 조개구이 맛집"}],"nw":1},{"k":"sc","n":"평화옥","la":37.47917,"ln":126.44061,"c":"kr","t":"restaurant","a":"인천광역시 중구 공항로 272 4층","h":"매일 06시 - 22시","w":[{"ti":"모닝와이드","m":"show","d":"모닝와이드 6754회 한식 맛집"}],"nw":1},{"k":"sc","n":"한식미담길 인천공항제2여객터미널점","la":37.46722,"ln":126.43466,"c":"kr","t":"restaurant","a":"인천광역시 중구 제2터미널대로 446 인천공항 제2여객터미널 B1 교통센터","h":"매일 07시 - 22시","w":[{"ti":"모닝와이드","m":"show","d":"모닝와이드 6754회 한식 맛집"}],"nw":1},{"k":"sc","n":"스타파이브 카페","la":37.43937,"ln":126.4315,"c":"kr","t":"cafe","a":"인천광역시 중구 공항서로 133-1","h":"매일 10시 - 21시","w":[{"ti":"빈센조","m":"drama","d":"3회에서 Vincenzo Cassano/박주형(송중기)이 바벨 그룹의 나덕진(나철)과 만나 타협을 하는 장면이다."}],"nw":1},{"k":"sc","n":"해변가든","la":37.4262,"ln":126.42031,"c":"kr","t":"restaurant","a":"인천광역시 중구 마시란로 51-12","h":"정보없음","w":[{"ti":"생방송 오늘아침","m":"show","d":"생방송오늘아침 2792회 기러기백숙 맛집"}],"nw":1},{"k":"sc","n":"실미도 해수욕장","la":37.40301,"ln":126.402