[{"k":"sc","n":"서울특별시 보라매병원","la":37.49329,"ln":126.92424,"c":"kr","t":"playground","a":"서울특별시 동작구 보라매로5길 20","h":"평일 08시 - 18시, 토 08시 30분 - 12시 30분","w":[{"ti":"가면","m":"drama","d":"변지숙(수애)의 어머니는 간 이식 수술을 위해 이곳에 입원했다. 17화에서 어머니는 최미연(유인영 분)의 방해로 제때 이식을 받지 못해 그녀 앞에서 사망한다."},{"ti":"구여친클럽","m":"drama","d":"김수진(송지효 분)이 이 병원에 있는 나지아(장지은 분)를 방문했을 때, 그녀는 9화에서 방명수(변요한 분)와 너무 가까운 동료인 그녀를 발견한다. 그녀는 그곳을 떠나 명수에게 병원 밖에서 제지를 당하자, 명수는 그에게 정말 사랑하…"},{"ti":"그녀는 예뻤다","m":"drama","d":"지성준(박서준)은 12회에서 쓰러진 뒤 이곳에서 치료를 받는다. 김신혁(최시원)은 그가 쓰러진 소식을 듣자마자 김혜진(황정음)을 이곳으로 데려온다. 그녀는 성준의 방으로 가서 그를 껴안고 그들은 마침내 키스를 한다."},{"ti":"다시 만난 세계","m":"drama","d":"성수지(김혜준 분)는 36회에 '태산의료원'으로 출연하는 이 병원에 입원하고 성영인(김가은 분)은 자신의 병을 알게 된다."},{"ti":"당신이 잠든 사이에","m":"drama","d":"정재찬(이종석 분)은 18회에서 밤톨이가 남홍주(배수지 분)라는 사실을 플래시백을 통해 비로소 깨닫는다."},{"ti":"별에서 온 그대","m":"drama","d":"8화에서 이희경(박해진 분)은 차가 절벽에서 떨어질 뻔하자 천송이(전지현 분)를 다시 병원으로 데려간다. 그들이 입구에서 도민준(김수현 분)과 마주치자 천송이는 도민준에게 그 순간 절벽에 있었던 적이 있는지 묻는다."}],"nw":11},{"k":"sc","n":"애플하우스","la":37.48625,"ln":126.98065,"c":"kr","t":"restaurant","a":"서울특별시 동작구 동작대로27다길 29 2층","h":"매일 10시 30분 - 21시","w":[{"ti":"다비치","m":"artist","d":"강민경의 고등학교 시절 단골 분식집"},{"ti":"소녀시대","m":"artist","d":"소녀시대 단골집인 즉석 떡볶이 맛집"},{"ti":"슈퍼주니어","m":"artist","d":"슈퍼주니어 규현이 추천한 추억의 떡볶이 맛집"},{"ti":"식신로드","m":"show","d":"식신로드1 147회 참게장/참게범벅 맛집"},{"ti":"우주소녀","m":"artist","d":"원픽로드 7회 엑시가 추천한 떡볶이집"}],"nw":5},{"k":"sc","n":"오코다리 방배점","la":37.48722,"ln":126.9827,"c":"kr","t":"restaurant","a":"서울특별시 서초구 방배로 62 성산빌딩 1,2층","h":"매일 11시 30분 - 21시","w":[{"ti":"2TV생생정보","m":"show","d":"2TV생생정보 1128회 전복코다리찜/코다리냉면"},{"ti":"모닝와이드","m":"show","d":"모닝와이드 6759회 명태 맛집"},{"ti":"생방송오늘저녁","m":"show","d":"생방송오늘저녁 731회 전복코다리찜"},{"ti":"생방송투데이","m":"show","d":"생방송투데이 3001회 코다리찜"}],"nw":4},{"k":"sc","n":"서울대학교","la":37.46226,"ln":126.95428,"c":"kr","t":"playground","a":"서울특별시 관악구 관악로 1","h":"매일 00시 - 24시","w":[{"ti":"가면","m":"drama","d":"6회에서 지숙의 형이 온 직후 민우도 그 자리를 찾아 화장실 청소를 하고 있는 지숙을 발견하고 당장 일을 그만두라고 명령한다."},{"ti":"스타의 연인","m":"drama","d":