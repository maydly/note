[{"k":"sc","n":"동해 논골담길","la":37.5528,"ln":129.11657,"c":"kr","t":"playground","a":"강원도 동해시 논골1길 2","h":"매일 00시 - 24시","w":[{"ti":"런온","m":"drama","d":"이영화(강태오)의 부모님은 이 마을에 살고 있으며, 그가 자란 곳이기도 하다. 14회에서는 사랑에 빠진 서단아(최수영)가 오미주(신세경)가 부모님을 도와 주말을 보내기 위해 이곳에 머물 때 그녀와 함께 영화를 보러 가자고 설득한다.…"},{"ti":"상속자들","m":"drama","d":"16~18회에서 차은상(박신혜)은 어머니와 함께 이 거리의 집으로 이사한다. 김탄(이민호)과 최영도(김우빈)가 찾아온다."},{"ti":"스물다섯 스물하나","m":"drama","d":"5회에서 부모님의 사업이 망해 백이진(남주혁)과 그의 동생은 이 마을로 이사 온다. 생계를 위해 이곳 시장에서 일을 시작한다"},{"ti":"아홉수 소년","m":"drama","d":"3화에서 마세영(경수진)과 강진구(김영광)는 여행사를 위해 '데이트 코스'를 짜기 위해 이 거리들을 걷는다. 이 지역은 그들에게 데이트를 위한 '비밀 핫스팟'으로 추천된다."}],"nw":4},{"k":"sc","n":"묵호등대전망대","la":37.55427,"ln":129.1185,"c":"kr","t":"playground","a":"강원도 동해시 해맞이길 289","h":"매일 00시 - 24시","w":[{"ti":"아홉수 소년","m":"drama","d":"3회에서도 마세영(경수진 분)과 강진구(김영광 분)가 여행으로 이곳에 온다. 사실 그들은 여행사에 여행 제의를 받으러 왔다."},{"ti":"애타는 로맨스","m":"drama","d":"이유미(송지은 분)는 대명리조트 솔비치 삼척에서 열리는 어머니의 결혼식에서 숨을 고르기 위해 1회에 등장한다."},{"ti":"찬란한 유산","m":"drama","d":"22회에서 이 회사로 출장을 갔을 때. 이 등대에서 현수교로 이어지는 작은 길로 돌아오는 길에 우환은 은성에게 마음을 고백하고 그녀는 도망가기 전에 키스를 한다."}],"nw":3},{"k":"sc","n":"해림횟집","la":37.5312,"ln":129.10685,"c":"kr","t":"restaurant","a":"강원도 동해시 동해대로 6270-31","h":"매일 10시 - 22시","w":[{"ti":"모닝와이드","m":"show","d":"모닝와이드 7137회 회 맛집"},{"ti":"식객허영만의백반기행","m":"show","d":"식객허영만의백반기행 160회 물막국수/회비빔막국수/수육 맛집"}],"nw":2},{"k":"sc","n":"묵꼬양 카페","la":37.55278,"ln":129.11232,"c":"kr","t":"restaurant","a":"강원도 동해시 산제골2길 19 2층","h":"매일 10시 - 21시","w":[{"ti":"6시 내고향","m":"show","d":"6시내고향 7512회 대추차 맛집"}],"nw":1},{"k":"sc","n":"어쩌다어달","la":37.56865,"ln":129.11708,"c":"kr","t":"stay","a":"강원도 동해시 일출로 309","h":"매일 00시 - 24시","w":[{"ti":"내 뒤에 테리우스","m":"drama","d":"23회에서 고애린(정인선)이 부모 집으로 돌아와 아르바이트를 하는 모습이 보인다."}],"nw":1},{"k":"sc","n":"칠형제곰치국","la":37.55467,"ln":129.12029,"c":"kr","t":"restaurant","a":"강원도 동해시 일출로 131-1","h":"매일 08시 - 15시","w":[{"ti":"모닝와이드","m":"show","d":"모닝와이드 7137회 곰치국 맛집"}],"nw":1},{"k":"sc","n":"삼본아파트 (봄날은 간다)","la":37.55927,"ln":129.11513,"c":"kr",