[{"k":"sc","n":"에버랜드","la":37.28965,"ln":127.21724,"c":"kr","t":"playground","a":"경기도 용인시 처인구 포곡읍 에버랜드로 199","h":"매일 10시 - 22시 (시기별 상이)","w":[{"ti":"갑동이","m":"drama","d":"6화에서 류태오(이준)가 마리아오(김민정)를 데리고 이 놀이공원에 왔다. 그리고 두 사람은 회전목마를 타며 그가 살인자일 수 있는 자신을 얼마나 용감하게 쫓고 있는지 말했고 하무염(윤상현)은 멀리서 상황을 지켜보고 있다."},{"ti":"검색어를 입력하세요 WWW","m":"drama","d":"8회 슈퍼레이스 챔피언십을 보기 위해 KU그룹 오진우(지승현)가 경마장을 찾았다. 놀랍게도 그의 아내 송가경(전혜진)이 합류한다."},{"ti":"김비서가 왜 그럴까","m":"drama","d":"2회에서 김미소(박민영)는 저녁에 박유식(강기영)과의 만남을 위해 이곳을 찾았다. 하지만 마침내 미팅은 취소가 되고 모든 것은 이영준(박서준)이 그녀의 마음을 얻기 위해 갑자기 그녀 앞에 등장하려고 한 계획이었다."},{"ti":"더킹 투하츠","m":"drama","d":"15~16회에서 이 공원에서 김항아(하지원)와 이재하(이승기)의 약혼식이 거행된다."},{"ti":"떼루아","m":"drama","d":"마지막 20회에서 김주혁(강태민)과 이우주(한혜진)가 프랑스로 떠나기 전 이곳을 찾는다."},{"ti":"러블리즈","m":"artist","d":"이상한 나라의 러블리즈 3,4,8화 촬영지"}],"nw":26},{"k":"sc","n":"용인공원","la":37.2985,"ln":127.2542,"c":"kr","t":"playground","a":"경기도 용인시 처인구 모현읍 새래로 158-33","h":"매일 08시 - 17시","w":[{"ti":"공항 가는 길","m":"drama","d":"3, 4회에서 애니(박서연)가 안식처가 된 곳이고 서도우(이상윤)가 그녀를 찾아온다."},{"ti":"날 녹여주오","m":"drama","d":"3화에서 마동찬(지창욱)의 돌아가신 아버지가 이곳 묘지에 안장되고 그를 찾아온다."},{"ti":"밥 잘 사주는 예쁜 누나","m":"drama","d":"서준희(정해인)와 장소연(서경선)의 어머니가 이곳에 안치됐다."},{"ti":"시간","m":"drama","d":"3회에서 천수호(김정현)의 엄마는 이곳에서 쉬고 있다고 거짓말을 하고 수호는 그녀를 찾으러 이곳으로 간다."},{"ti":"어쩌다 발견한 하루","m":"drama","d":"22화(전체 11화)에서 기일을 맞아 백경(이재욱)이 이곳을 찾아간다. 은단오(김혜윤)가 잠시 후 합류한다. 잠시 자리에 앉자 그는 그녀에게 자신이 기댈 수 있는 사람은 그녀뿐이라고 말한다."},{"ti":"저글러스","m":"drama","d":"2회에서 남치원(최다니엘)이 돌아가신 삼촌에게 조의를 표하기 위해 찾아왔다. 그리고 삼촌의 친구이기도 한 도 부사장(김창완)과 마주친다. 3, 4회에서 서도우(이상윤)가 그녀를 찾아온 곳이다. 12회에서는 김혜원(장희진)이 그녀를…"}],"nw":7},{"k":"sc","n":"대웅경영개발원","la":37.28164,"ln":127.24102,"c":"kr","t":"playground","a":"경기도 용인시 처인구 포곡읍 두계로 72","h":"매일 00시 - 24시","w":[{"ti":"검법남녀","m":"drama","d":"드라마의 국과수 본부 배경이다."},{"ti":"검법남녀 2","m":"drama","d":"법의학 수사관 백범(정재영)과 그의 팀이 기반을 두고 있습니다."}],"nw":2},{"k":"sc","n":"어량","la":37.26908,"ln":127.23799,"c":"kr","t":"restaurant","a":"경기도 용인시 처인구 포곡읍 금어로 216","h":"매일 11시 - 21시 30분","w":[{"ti":"생활의달인","m":"show","d":"생활