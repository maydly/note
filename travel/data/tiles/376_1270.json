[{"k":"sc","n":"성신여자대학교 운정그린캠퍼스","la":37.63222,"ln":127.0273,"c":"kr","t":"playground","a":"서울특별시 강북구 도봉로76가길 55","h":"매일 00시 - 24시","w":[{"ti":"구미호뎐","m":"drama","d":"5화, 8화에서 '우진대학교병원'으로 나오고, 남지아(조보아)는 이곳에서 이연(이동)과 마주친다."},{"ti":"그 남자의 기억법","m":"drama","d":"12화(풀 6화)에서 장례식장 외관으로 나온다."},{"ti":"나빌레라","m":"drama","d":"이 건물의 외관은 1화에서 기승주(김태훈)가 방문하는 은소리(윤지혜)의 사무실로 등장한다."},{"ti":"멜랑꼴리아","m":"drama","d":"7, 8회에서 보듯 류승재(최대훈)가 비서실장으로 근무하는 교육청 건물로 보인다."},{"ti":"미스터 기간제","m":"drama","d":"3회에서 임시 교사로 잠복한다."},{"ti":"바람피면 죽는다","m":"drama","d":"한강병원'으로 등장한다."}],"nw":17},{"k":"sc","n":"서울과학기술대학교","la":37.62963,"ln":127.07845,"c":"kr","t":"playground","a":"서울특별시 노원구 공릉로 232","h":"매일 00시 - 24시","w":[{"ti":"간 떨어지는 동거","m":"drama","d":"1화에서 보듯 이담(혜리)이 대학생으로 다니는 '서과대' 캠퍼스로 등장한다."},{"ti":"역도요정 김복주","m":"drama","d":"마지막 16화 육상에서의 마지막 키스신이 위치하며 부분적으로 '한올체육대학교'로 표시됩니다. 김복주(이성경)와 정준형(남주혁)이 자주 만나는 호수도 이곳에 있다."},{"ti":"이번 생은 처음이라","m":"drama","d":"13회 플래시백 장면에서 윤지호(정소민)와 우수지(이솜)가 이 대학의 호수[붕어방]에서 '열아홉 번째 방으로'에 대해 이야기하는 것을 본다."},{"ti":"진심이 닿다","m":"drama","d":"오윤서(유인나)와 권정록(이동욱)은 4회에 이곳에서 만나 법률 과외를 받는다. 그녀는 그것이 다소 낭만적이라고 상상했지만, 그것은 결국 다소 지루한 공부 시간이 되었다."},{"ti":"치즈 인 더 트랩","m":"drama","d":"유정(박해진)이 참석했다. 여기에 소개된 건물은 다산관(다산관), 정자(미래관) 4층(극장용 자판기가 있는 곳), 학생회관 복사실이다"},{"ti":"터널","m":"drama","d":"드라마에서 '화양대학교'로 등장한다."}],"nw":7},{"k":"sc","n":"마들원","la":37.63639,"ln":127.07128,"c":"kr","t":"restaurant","a":"서울특별시 노원구 공릉로62길 27-11","h":"매일 11시 30분 - 21시 30분","w":[{"ti":"굿캐스팅","m":"drama","d":"13회에서 장사를 이야기하던 중 옆방에 앉은 윤석호(이상엽)와 변우석(허재호)의 말을 엿듣는다."},{"ti":"너도 인간이니","m":"drama","d":"13회에서 건호 회장(영규)와 지영훈(이준혁)은 레스토랑 우마이(우마이)에서 남신Ⅲ(서강준)를 만나기로 한다. 그리고 자신의 자리에 진짜 남신이 왔다는 사실을 알게 된다."},{"ti":"달리와 감자탕","m":"drama","d":"6화에서 진기철(이제연)은 이 식당에서 정치인 안상태와 만난다."},{"ti":"보좌관","m":"drama","d":"8화에서 식사하는 장면으로 나온다."},{"ti":"사내맞선","m":"drama","d":"11화에서 진영서(설인아)의 아버지(이기영)는 남자친구 차성훈(김민규)과 함께 딸을 이 식당으로 초대한다."},{"ti":"왜 오수재인가","m":"drama","d":"10회에서 백진기(김창완) 서정대 로스쿨 학장이 이 식당에서 비즈니스 미팅을 하고 있다."}],"nw":7},{"k":"sc","n":"더달다","la":37.64444,"ln":127.00566,"c":"kr","t":"cafe","a":"서울특별시 강북구 4.19로21길 18","h":"정보없음","w":[{"ti":"거짓말의 거짓말","m":"drama","d":"16회에서 강지민(연정훈) 가족과 지은수(이유리)가 이 카페에서 함께 저녁을 먹는다."},{"ti":"로봇이 아니야","m":"drama","d":"2회에서 조지아(채수빈)가 친구의 카페 '여름눈'으로 출연해 전 남자친구 홍백균이 로봇 아지3의 모델로 얼굴을 사용한 과정을 이야기한다. 에피소드 4에서 그녀는 오빠의 집에서 쫓겨난 후 이곳에서 밤을 보낸다."},{"ti":"맨홀-이상한 나라의 필","m":"drama","d":"이곳은 드라마 안에서 '봉봉술집' 또는 '봉봉카페'로 등장하는데, 친구들이 항상 자주 모이는 곳으로 나온다. 예를 들어 9화에서는 윤진숙(정혜성)의 생일을 이곳에서 축하한다."},{"ti":"봄밤","m":"drama","d":"6화에서 이 카페는 유지호(정해인)가 집에 가는 길목에 있는 곳으로, 그가 이곳을 지나치는 장면이 종종 드라마에 나온다."},{"ti":"세상에서 가장 아름다운 이별","m":"drama","d":"1회에서는 여자친구 재영(손나은)과 함께 클럽에 갔다가 돌아온 뒤 술에 잔뜩 취한 정정수(최민호)가 이 카페 계단에서 기절할 뻔했고, 여동생 정윤수(최지우)는 집에 가고 싶냐고 묻는다."},{"ti":"You Raise Me Up (유 레이즈 미 업)","m":"drama","d":"6회에서 이용식(윤시윤)은 술 취한 이두라(하니)를 업고 이 카페를 지나친다."}],"nw":6},{"k":"sc","n":"서울의료원","la":37.61274,"ln":127.09819,"c":"kr","t":"playground","a":"서울특별시 중랑구 신내로 156","h":"평일 09시 - 17시 30분, 토 09시 - 12시 30분","w":[{"ti":"내 마음이 들리니","m":"drama","d":"6회에서 장준하(남궁민)가 이 병원에서 일하기 시작한다."},{"ti":"설렘주의보","m":"drama","d":"4화에서 차우현(천정명)의 어머니가 이곳에 입원한다."},{"ti":"질투의 화신","m":"drama","d":"태양대학교 병원으로 나온다. 이화신(조정석)이 치료를 받고 화신의 형이 죽는 곳이다"},{"ti":"초면에 사랑합니다","m":"drama","d":"이 병원의 외관은 도민익(김영광)이 의사 삼촌 구석찬(김병춘)에게 치료를 받는 상모병원으로 나타난다."},{"ti":"최고의 사랑","m":"drama","d":"독고진(차승원)은 이 병원에서 치료를 받는다. 2화에서 그는 '교통사고'로 치료를 받기 위해 이곳에 남았지만, 이는 사실상 영화 제의를 철회할 수 있는 기회이다. 3화에서는 심장에 이상이 생긴 것 같아 이 병원에서 심전도 검사를 받…"},{"ti":"화유기","m":"drama","d":"화유기 11화에서 우휘(차승원)가 치료를 받는 장면에 나오는 병원이다."}],"nw":6},{"k":"sc","n":"서경대학교","la":37.61509,"ln":127.0124,"c":"kr","t":"playground","a":"서울특별시 성북구 서경로 124","h":"매일 00시 - 24시","w":[{"ti":"너를 싫어하는 방법","m":"drama","d":"이 대학교는 대오미리(이지인)와 한대강(NCT 드림 재민)이 다니는 '서중대학교'로 나온다."},{"ti":"라이브온","m":"drama","d":"이 대학 혜인빌딩은 백호랑(정다빈), 고은택(황민현), 지소현(양혜지)이 공부하는 메인 '서연고' 건물의 배경이다."},{"ti":"밀회","m":"drama","d":"12, 13회에서 나오는 대학교 배경이다."},{"ti":"잘 하고 싶어","m":"drama","d":"이 곳은 서연대학교로 나온다."},{"ti":"지옥","m":"drama","d":"새진리회 지옥행 시연 장면으로 나온 강당공간"},{"ti":"펜트하우