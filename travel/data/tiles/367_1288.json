[{"k":"sc","n":"고산정","la":36.76772,"ln":128.89212,"c":"kr","t":"playground","a":"경상북도 안동시 도산면 가송길 177-42","h":"매일 00시 - 24시","w":[{"ti":"1박2일 시즌4","m":"show","d":"1박2일 시즌 4 8회차 촬영지"},{"ti":"미스터 션샤인","m":"drama","d":"2화에서 최유진(이병헌)은 이 정자 맞은편 강둑에 찾아와 어린 시절 인도교에서 배를 타고 숨었던 모습을 회상한다. 그리고는 가까운 식당에 앉아 백숙을 대접받는다. 10화에서는 고애신(김태리)과 유진 최(이병헌)가 이곳 앞의 얼어붙은…"},{"ti":"조선로코 녹두전","m":"drama","d":"7회에서 전녹두(장동윤), 동동주(김소현), 앵두(박다연)는 소풍을 하러 온다. 녹두와 동주가 보트를 타고 다투는 장면. 동주는 녹두가 물에 빠졌다고 생각하고 그를 구하기 위해 달려가다가 자신이 녹두의 이름을 모른다는 것을 깨닫는다."}],"nw":3},{"k":"sc","n":"도산서원","la":36.72701,"ln":128.8436,"c":"kr","t":"playground","a":"경상북도 안동시 도산면 도산서원길 154","h":"하절기 매일 09시 - 18시, 동절기 매일 09시 - 17시","w":[{"ti":"1박2일 시즌4","m":"show","d":"1박2일 시즌 4 7회 경북 안동 출현 장소"}],"nw":1},{"k":"sc","n":"이육사문학관","la":36.73899,"ln":128.863,"c":"kr","t":"playground","a":"경상북도 안동시 도산면 백운로 525","h":"화-일 09시 - 18시","w":[{"ti":"1박2일 시즌4","m":"show","d":"1박2일 시즌 4 7회차 이육사 시인 명소"}],"nw":1},{"k":"sc","n":"노송정","la":36.74978,"ln":128.82849,"c":"kr","t":"playground","a":"경상북도 안동시 도산면 온혜리 604","h":"매일 00시 - 24시","w":[{"ti":"1박2일 시즌4","m":"show","d":"1박2일 시즌 4 8회차 베이스캠프"}],"nw":1},{"k":"sp","n":"유교문화박물관","o":"","la":36.70197,"ln":128.81127,"c":"kr","sk":"museum","f":0},{"k":"sp","n":"경상북도산림과학박물관","o":"","la":36.71169,"ln":128.82287,"c":"kr","sk":"museum","f":0},{"k":"sp","n":"도산서원","o":"","la":36.72658,"ln":128.84331,"c":"kr","sk":"see","f":0},{"k":"sp","n":"학소대","o":"","la":36.76749,"ln":128.88213,"c":"kr","sk":"view","f":0},{"k":"sp","n":"전망대","o":"","la":36.7606,"ln":128.87546,"c":"kr","sk":"view","f":0},{"k":"sp","n":"도산서원","o":"","la":36.72717,"ln":128.84352,"c":"kr","sk":"castle","f":0},{"k":"sp","n":"농암종택","o":"","la":36.76424,"ln":128.88506,"c":"kr","sk":"castle","f":0},{"k":"sp","n":"분강서원","o":"","la":36.76508,"ln":128.88463,"c":"kr","sk":"castle","f":0},{"k":"sp","n":"애일당","o":"","la":36.76637,"ln":128.88384,"c":"kr","sk":"castle","f":0},{"k":"sp","n":"퇴계종택","o":"","la":36.73682,"ln":128.84856,"c":"kr","sk":"castle","f":0},{