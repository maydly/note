[{"k":"sc","n":"선문대학교 아산캠퍼스","la":36.79895,"ln":127.07489,"c":"kr","t":"playground","a":"충청남도 아산시 탕정면 선문로221번길 70","h":"매일 00시 - 24시","w":[{"ti":"눈의 여왕","m":"drama","d":"1회에서 한태웅(현빈)과 김정규(이선호)가 1위를 다투는 제39회 국제수학올림피아드가 중앙도서관에서 열린다."},{"ti":"미스터 기간제","m":"drama","d":"11회에서 거짓말의 수업 임시 교사로 잠복한다."},{"ti":"스위치 - 세상을 바꿔라","m":"drama","d":"이 대학이 검찰청으로 등장한다."},{"ti":"악마판사","m":"drama","d":"7화 꿈에서 김가온(박진영)은 사기꾼의 삶을 끝내기 위해 결심한 사기꾼 도영춘(부모의 죽음에 책임이 있는 사기꾼)의 심판에 참석하기 위해 다시 찾아간다."},{"ti":"원 더 우먼","m":"drama","d":"본관은 서울중앙지검 건물로 보인다. 1화에서 조연주(이하늬)와 안유준(이원근)이 함께 건물에 도착하는 모습이 그려졌다. 7회에는 중앙도서관[선문대학교 중앙도서관]도 나온다."},{"ti":"진심이 닿다","m":"drama","d":"오윤서(유인나 분)와 권정록(이동욱 분)이 3회에서 재판을 성공적으로 마치고 이곳을 산책한다. 정록은 윤서의 칭찬에 가슴을 설레게 하고, 목도리가 바람에 날리면 목에 감는다. 정록이 또 다른 사건을 변호하러 온 5화에서 둘 다 이곳…"}],"nw":8},{"k":"sc","n":"호서대학교 아산캠퍼스","la":36.73548,"ln":127.0741,"c":"kr","t":"playground","a":"충청남도 아산시 배방읍 호서로79번길 20","h":"매일 00시 - 24시","w":[{"ti":"검색어를 입력하세요 WWW","m":"drama","d":"1화에서 UNICON 대표로 배타미/타미(임수정)의 상원 청문회가 본 대학 벤처산업협력동 회의실에서 열린다. 태미는 주변 취재진을 빠져나갈 때 스칼렛이 경쟁사에 다니는 줄도 모르고 차현/스칼렛(이다희)의 차에 뛰어든다."},{"ti":"멜랑꼴리아","m":"drama","d":"지윤수(임수정 분)와 백승유(이도현 분), 성예린(우다비 분) 등 주인공들이 수학교사로 일하는 '아성고등학교'로 나온다. 1회에서 지윤수(임수정 분)가 익명으로 어려운 시험문제를 푼 백승유(이도현 분)를 찾다가 미술관 옆 헛간에서…"},{"ti":"어게인 마이 라이프","m":"drama","d":"2회에서 김희우(이준기)가 다시 학업을 시작하는 한국대학교로 나온다. 같은 에피소드에서 신입생 파티가 열리는 '다이크홀'로 학술정보센터[중앙도서관 정보관]가 등장한다."},{"ti":"크레이지 러브","m":"drama","d":"노고진(김재욱) GOTOP교육 대표가 1회에서 이 대학 강석규 교육원에서 초청 강연을 하고 있다."}],"nw":4},{"k":"sc","n":"외암민속마을","la":36.73002,"ln":127.01647,"c":"kr","t":"playground","a":"충청남도 아산시 송악면 외암민속길 5","h":"하절기 화-일 09시 - 18시, 동절기 화-일 09시 - 17시","w":[{"ti":"비","m":"artist","d":"영화 차전차왕 속 비의 생엄복동의 생가"},{"ti":"클래식","m":"movie","d":"준하와 주희의 첫 만남이 이루어진 장소"},{"ti":"태극기 휘날리며","m":"movie","d":"제사를 지내고 피난 떠나는 장면의 배경지"}],"nw":3},{"k":"sc","n":"아산짚불장어","la":36.78593,"ln":127.00295,"c":"kr","t":"restaurant","a":"충청남도 아산시 시민로422번길 11 1층","h":"매일 11시 - 22시","w":[{"ti":"모닝와이드","m":"show","d":"모닝와이드 7562회 짚불무태장어구이 맛집"},{"ti":"생방송투데이"