[{"k":"sc","n":"경희대학교 서울캠퍼스","la":37.59536,"ln":127.05276,"c":"kr","t":"playground","a":"서울특별시 동대문구 경희대로 26","h":"매일 00시 - 24시","w":[{"ti":"그놈이 그놈이다","m":"drama","d":"10화에서 황지우(윤현민 분)는 서현주(황정음 분)를 이곳 도서관으로 불러들여 과거의 삶(각각 강진호와 송민주의 모습으로)을 보여준다."},{"ti":"로맨스는 별책부록","m":"drama","d":"2화에서 차은호(이종석)오 김재민(김태우) 겨루출반 대표가 처음 만나는 곳으로 인터뷰에서 설명한다."},{"ti":"멜랑꼴리아","m":"drama","d":"이 건물은 극중 감독 노정아(진경)가 학부모와 학생들에게 연설하는 '아성고등학교'의 일부로 보인다."},{"ti":"미세스 캅 2","m":"drama","d":"3화에서 이 학교 도서관에 온다."},{"ti":"별똥별","m":"drama","d":"5회에서 공태성(김영대)은 시상식 장면을 이곳에서 촬영하는데, 이 장면 역시 오한별(이성경 분)이 눈치채지 못하는 것에 점점 더 화가 난다."},{"ti":"아직 낫 서른","m":"drama","d":"3화에서 홍아영(차민지)은 짝사랑하는 동안 이 건물을 배경으로 친구들과 걸었다. 이승유(강민혁)가 전 여자친구 이혜령(김지성)에게 차가운 어깨를 안겨주는 장면. 8회에서 한예린(김남주)과 윤석찬(박신)이 건물 밖에서 그를 끌어안고…"}],"nw":12},{"k":"sc","n":"서울시립대학교","la":37.58338,"ln":127.05997,"c":"kr","t":"playground","a":"서울특별시 동대문구 서울시립대로 163","h":"매일 00시 - 24시","w":[{"ti":"계룡선녀전","m":"drama","d":"이는 정이현(윤현민 분)이 강의하는 곳이자 선옥남(고두심 분/문채원 분)이 근무하는 베이반스 커피 카페가 위치한 '엄마요정과 나무꾼' 이원대의 배경이다. 2회에서는 옥남과 딸 전섬(구구단 강미나)이 머리 약속을 마치고 카페로 돌아가…"},{"ti":"로맨스는 별책부록","m":"drama","d":"차은호(이종석 분)가 13화에서 강연을 하러 온다. 강의 도중 송해린(정유진 분)으로부터 강단이(이나영 분)가 회사를 그만뒀다는 내용의 문자메시지를 받는다."},{"ti":"멜랑꼴리아","m":"drama","d":"백승유(이도현)는 2화에서 배치 테스트를 하기 위해 UOS 센테니얼 기념관에서 아버지 백민식(김호진)에게 내려준다.3화 초반에 아성고등학교를 대표하기 위한 경쟁을 벌였고, 몇 년 후 7화에서 학교 모임에서 그가 선생님으로 소개되었다…"},{"ti":"부부의 세계","m":"drama","d":"창공관의 외관은 지선우(김희애 분)가 부원장으로 근무하는 '가족사랑병원'으로 등장한다."},{"ti":"아는 와이프","m":"drama","d":"차주혁(지성)과 이혜원(강한나)이 다녔던 대학으로 나온다. 마지막 16화에서 주혁은 서우진(한지민)의 산책을 다시 데려오고 그들의 미래에 대해 이야기한다."},{"ti":"이태원 클라쓰","m":"drama","d":"이 대학은 박새로이(박서준)가 밖에서 기다리는 동안 오수아(권나라)가 법학부 건물에서 입학시험을 치르는 '광진대학교'로 등장한다."}],"nw":7},{"k":"sc","n":"서울뼈구이매운족발","la":37.58502,"ln":127.05124,"c":"kr","t":"restaurant","a":"서울특별시 동대문구 왕산로 274-1","h":"화-일 12시 - 22시","w":[{"ti":"미운 우리 새끼","m":"show","d":"이상민과 김보성이 운동 후 다녀온 족발집"},{"ti":"생활의달인","m":"show","d":"생활의달인 729회 매운등뼈구이 맛집"}],"nw":2},{"k":"sc","n":"메이솝","la":37.58065,"ln":127.05522,"c":"kr","t":"playground","