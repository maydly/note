[{"k":"sc","n":"압구정나들목","la":37.37399,"ln":126.43924,"c":"kr","t":"playground","a":"서울특별시 강남구 압구정동 압구정나들목","h":"매일 00시 - 24시","w":[{"ti":"굿캐스팅","m":"drama","d":"3회 구비서(한수진)은 전체에서 정보를 교환하기 위해 이 터널에서 랑데뷰를 하고, 제보자가 자신이 의지해야 할 정보를 넘기기 싫을 때 그녀의 무술실력을 보여준다."},{"ti":"그녀는 거짓말을 너무 사랑해","m":"drama","d":"그래피티 터널은 윤수림(레드벨벳 조이)이 강한결(이현우)을 찾으며 여우야를 부르던 배경 중 하나로 등장했다."},{"ti":"또! 오해영","m":"drama","d":"2회에서 이 터널은 박도경(에릭)이 미친 듯이 오해영(전혜빈)을 찾는데 마침내 그녀의 sns 계정에 다른 남자와 파리에 있다는 사실을 알게되는 회상 장면에 등장한다."},{"ti":"슈츠","m":"drama","d":"9화의 뺑소니(살인) 사건은 이 터널 직전에 발생했고, 고연우(박형식)는 혼자 현장을 보러 이곳에 와서 피해자가 의뢰인의 차에 치이기 전에 터널에서 그림을 그렸다는 사실을 깨닫는다."},{"ti":"스물다섯 스물하나","m":"drama","d":"10화에서 문지웅(최현욱)이 브레이크 댄서들과 함께 (힙합은 미래이기 때문에) 여기에서 어울리고 있다."},{"ti":"페이지 터너","m":"drama","d":"1회에서 정차식(지수)은 친구들과 함께 이 터널에 설치된 업라이트 피아노에 멈춘다. 2화에서 윤유슬(김소현)을 데려와 피아노를 부탁한다. 3화에서 두 사람은 피아노 2인용 콩쿠르를 위해 연습을 했다."}],"nw":7},{"k":"sc","n":"도랫마을","la":37.38304,"ln":126.41046,"c":"kr","t":"restaurant","a":"인천광역시 중구 하나개로 142","h":"평일 10시 - 20시, 주말 08시 30분 - 21시","w":[{"ti":"6시 내고향","m":"show","d":"6시내고향 7619회 전어, 낙지요리 맛집"},{"ti":"생방송 오늘아침","m":"show","d":"생방송오늘아침 2564회 동죽 맛집"}],"nw":2},{"k":"sc","n":"황금손해물칼국수 무의점","la":37.38875,"ln":126.42639,"c":"kr","t":"restaurant","a":"인천광역시 중구 대무의로 309-17","h":"목-화 09시 - 20시","w":[{"ti":"2TV생생정보","m":"show","d":"2TV생생정보 1607회 꽃게칼국수, 해물파전 맛집"}],"nw":1},{"k":"sc","n":"소무의도 인도교","la":37.37399,"ln":126.4392,"c":"kr","t":"playground","a":"인천광역시 중구 무의동 산369","h":"매일 00시 - 24시","w":[{"ti":"엔젤아이즈","m":"drama","d":"19회에서 윤수완(구혜선)이 자전거를 타고 소무의도에서 마을 노인들을 섬기는 다리를 건넜다."}],"nw":1},{"k":"sc","n":"소무의도","la":37.37164,"ln":126.44355,"c":"kr","t":"playground","a":"인천광역시 중구 무의동 산369","h":"매일 00시 - 24시","w":[{"ti":"NCT","m":"artist","d":"NCT 도영이 가족들과 휴가를 보낸 곳"}],"nw":1},{"k":"sp","n":"국사봉","o":"","la":37.39218,"ln":126.41755,"c":"kr","sk":"nature","f":1},{"k":"sp","n":"전망대","o":"","la":37.37491,"ln":126.44634,"c":"kr","sk":"view","f":0},{"k":"sp","n":"하나개해변","o":"","la":37.38584,"ln":126.40889,"c":"kr","sk":"nature","f"