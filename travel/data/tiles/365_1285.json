[{"k":"sc","n":"부용대","la":36.54291,"ln":128.51663,"c":"kr","t":"playground","a":"경상북도 안동시 풍천면 광덕솔밭길 72","h":"매일 00시 - 24시","w":[{"ti":"검법남녀 2","m":"drama","d":"검찰과 형사팀이 정신분열증 환자 조한수를 쫓는 장면은 21회에서 나온다. 검사 도지한(오만석 분)이 조승희를 도와줄 사람들이 모두 있다는 것을 납득시키려 해도 결국 조승희는 절벽에서 아래 강으로 뛰어내린다."},{"ti":"달의 연인 - 보보경심 려","m":"drama","d":"12회에서는 왕자 왕소(이준기)가 1년 만에 궁으로 돌아온 후 이 절벽을 지나게 된다. 8황자 왕요(홍종현)가 반역죄로 궁지에 몰리고 13화 마지막 싸움에서 왕소에게 살해당한 곳이기도 하다."},{"ti":"마이 온리 러브송","m":"drama","d":"온달(씨엔블루 이종현)은 13화에서 송수정(공승연)에게 이 절벽 꼭대기에서 연을 날리는 방법을 보여주고, 결국 키스를 하게 된다."},{"ti":"아랑사또전","m":"drama","d":"그는 5화에서 아랑(신민아)이 자신의 '입냄새' 때문에 어머니가 분명히 떠났다고 말하자 화가 나서 이곳에 온다. 7화에서 은오는 이 절벽의 나무에 올려놓은 부적을 찾아 다시 찾아온다. 부적을 얻기 위해 나무 위로 올라가다가 절벽에서…"},{"ti":"조선로코 녹두전","m":"drama","d":"3회(전체2회)에서 허윤(김태우)과 정윤저(이승준)는 이 절벽의 순간을 회상한다."},{"ti":"흑기사","m":"drama","d":"6화에서 샤론(서지혜)은 강물에 빠져 죽으려 하고 장백희(장미희)는 그녀가 이 절벽 아래에 의식을 잃은 채 누워 있는 것을 발견한다."}],"nw":6},{"k":"sc","n":"옥연정사","la":36.54364,"ln":128.51788,"c":"kr","t":"playground","a":"경상북도 안동시 풍천면 광덕솔밭길 86","h":"매일 입실 15시, 퇴실 11시","w":[{"ti":"광해","m":"movie","d":"영화 광해에서 이병헌이 총애하던 상궁의 집"}],"nw":1},{"k":"sc","n":"안동하회마을 만송정 숲","la":36.54014,"ln":128.51514,"c":"kr","t":"playground","a":"경상북도 안동시 풍천면 하회리 1164-1","h":"매일 00시 - 24시","w":[{"ti":"써니","m":"movie","d":"나미의 첫사랑과 수지의 키스 장소"}],"nw":1},{"k":"sc","n":"병산서원","la":36.54056,"ln":128.55275,"c":"kr","t":"playground","a":"경상북도 안동시 풍천면 병산길 386","h":"매일 09시 - 18시 하절기, 매일 09시 - 17시 동절기","w":[{"ti":"철인왕후","m":"drama","d":"김소용(신혜선)과 철종(김정현)은 이곳에서 차를 마시다 스핀킥으로 침입자로부터 자신을 보호하는 모습에 심장이 조금 뛴다."}],"nw":1},{"k":"sc","n":"마애솔숲문화공원","la":36.55199,"ln":128.59012,"c":"kr","t":"playground","a":"경상북도 안동시 풍산읍 마애리 40-2","h":"매일 00시 - 24시","w":[{"ti":"화랑","m":"drama","d":"드라마에서 보인 마애솔숲 기암 절벽"}],"nw":1},{"k":"sp","n":"하회동탈박물관","o":"","la":36.54891,"ln":128.52764,"c":"kr","sk":"museum","f":0},{"k":"sp","n":"유교문화전시관","o":"","la":36.55507,"ln":128.5312,"c":"kr","sk":"museum","f":0},{"k":"sp","n":"부용대 (Buyongdae Cliff)","o":"부용대","la":36.54283,"ln":128.51643,"c":"