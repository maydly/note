[{"k":"sc","n":"휘닉스제주 섭지코지","la":33.42908,"ln":126.93397,"c":"kr","t":"stay","a":"제주특별자치도 서귀포시 성산읍 섭지코지로 107","h":"매일 입실 14시, 퇴실 11시","w":[{"ti":"꽃보다 남자","m":"drama","d":"21회에서 금잔디(구혜선)에게 이 식당을 찾아오게 하고, 그는 구준표(이민호)와 하재경(이민정)의 결혼을 막을 수 있는 마지막 기회라고 주장하면서도 자신의 우정을 쌓아 행복해질 수 있다고 말한다."},{"ti":"멜랑꼴리아","m":"drama","d":"4화에서 지윤수(임수정)와 백승유(이도현)가 제주 당일치기 여행으로 이 갤러리를 찾는다. 참고: 갤러리의 외관만 전시되었으며, 이 전시회는 벙커 드 뤼미에르[Bunker de Lumieres]에서 열렸을 것으로 보인다."},{"ti":"오렌지 마말레이드","m":"drama","d":"3회에서 백마리(설현)가 먼저 라이트하우스에 와서 자신이 이미 정재민(여진구)에게 빠졌고, 그가 그리웠다는 것을 깨달았다. 그때 재민이도 나타나 그곳에서 마리를 발견했기 때문에 소원이 이루어졌다고 말했다. 그들은 마침내 서로에 대한…"},{"ti":"인현왕후의 남자","m":"drama","d":"6회에서 희진(유인나)과 그녀의 친구이자 매니저인 조수경(가득희)은 제주도에서 김붕도(지현우)를 만난 후 이곳으로 왔다. 여기서 차를 마시고 수경은 붕도가 안전한 남자친구인지 확인하기 위해 붕도의 신분을 확인한다."},{"ti":"푸른 바다의 전설","m":"drama","d":"1회에서 스페인행 비행기에서 만난 승무원과 데이트를 하러 왔다."}],"nw":5},{"k":"sc","n":"막내해녀","la":33.4122,"ln":126.90477,"c":"kr","t":"restaurant","a":"제주특별자치도 서귀포시 성산읍 환해장성로 183","h":"정보없음","w":[{"ti":"기분좋은 날","m":"show","d":"기분좋은날 2311회 해산물 맛집"},{"ti":"기분좋은 날","m":"show","d":"기분좋은날 2311회 녹차 맛집"}],"nw":2},{"k":"sc","n":"팔도식당갈치조림 섭지코지점","la":33.43766,"ln":126.91993,"c":"kr","t":"restaurant","a":"제주특별자치도 서귀포시 성산읍 섭지코지로26번길 15","h":"매일 08시 - 20시","w":[{"ti":"6시 내고향","m":"show","d":"6시내고향 7584회 갈치요리 맛집"}],"nw":1},{"k":"sc","n":"해녀의집","la":33.47799,"ln":126.90828,"c":"kr","t":"restaurant","a":"제주특별자치도 서귀포시 성산읍 시흥하동로 114","h":"매일 07시 - 20시","w":[{"ti":"6시 내고향","m":"show","d":"6시내고향 7617회 소라찜, 조개죽, 성게회 , 오분자기찜 맛집"}],"nw":1},{"k":"sc","n":"소심한책방","la":33.49144,"ln":126.90309,"c":"kr","t":"playground","a":"제주특별자치도 제주시 구좌읍 종달동길 29-6","h":"매일 10시 - 18시","w":[{"ti":"경우의 수","m":"drama","d":"이수(워너원 옹성우)와 동행한 경우연(신예은)은 2회에서 자신의 서예 엽서 전시 및 판매에 대해 서점에 문의한다."}],"nw":1},{"k":"sc","n":"성산보말죽칼국수 성산점","la":33.4717,"ln":126.91715,"c":"kr","t":"restaurant","a":"제주특별자치도 서귀포시 성산읍 해맞이해안로 2725","h":"월-토 07시 - 20시","w":[{"ti":"런온","m":"drama","d":"언론과 육상팀 소란을 피운 뒤 기선겸(임시완)과 신미주(신세경)는 성산일출봉(일출)을 감상하고 파도를 보기 위해 해변으로 향한다. 4회에서 전복을 먹기로 결정하